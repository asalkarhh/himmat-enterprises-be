# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/himmat_dev
SPRING_DATASOURCE_USERNAME=himmat_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Server
SERVER_PORT=8080

# Security - JWT (Secret MUST be at least 256 bits / 32 characters)
APP_SECURITY_JWT_SECRET=replace_with_a_cryptographically_secure_random_key_of_at_least_32_characters
APP_SECURITY_JWT_EXPIRATION_SECONDS=1800
APP_SECURITY_JWT_ISSUER=himmat-enterprises
APP_SECURITY_JWT_AUDIENCE=himmat-app

# Security - Throttling
APP_SECURITY_THROTTLE_MAX_ATTEMPTS=5
APP_SECURITY_THROTTLE_WINDOW_MINUTES=15

# Bootstrap Initial Owner & Settings (Set APP_BOOTSTRAP_ENABLED=true only for initial bootstrap command, then disable)
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_USERNAME=himmat_owner
APP_BOOTSTRAP_DISPLAY_NAME=Himmat Owner
APP_BOOTSTRAP_PASSWORD=replace_with_strong_owner_password
APP_BOOTSTRAP_SHOP_NAME=Himmat Enterprises

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Docs & Monitoring (Set false / never in production)
APP_DOCS_ENABLED=true
MANAGEMENT_HEALTH_SHOW_DETAILS=never
